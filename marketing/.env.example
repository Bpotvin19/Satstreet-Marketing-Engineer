# ── Claude ───────────────────────────────────────────────────────────────────
# Optional: leave unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# The private marketing group. Group ids are negative. Comma-separate to allow
# more than one chat. The bot refuses to start without this — a bot can be added
# to any group by anyone who knows its username, and this one carries Satstreet's
# positioning and the list of things we don't say publicly.
TELEGRAM_CHAT_ID=

# ── Calendar ─────────────────────────────────────────────────────────────────
# Sources are tried in order: Notion page → Google Sheet → marketing/calendar.json.
# The file is always the fallback, so a Notion outage degrades to a stale
# calendar rather than none.

# The team's Notion Calendar page. Reads its at-a-glance table plus the
# per-event detail tables (why it matters, content angles, formats).
NOTION_CALENDAR_PAGE_ID=

# Link-shared Google Sheet ("anyone with the link can view").
MARKETING_SHEET_ID=
MARKETING_SHEET_TAB=

# ── Published log ────────────────────────────────────────────────────────────
# Optional. Unset → the log lives in marketing/.state (works, but local only).
# Set both → approvals are recorded in Notion, survive the box, and are visible
# to the team. Database needs: Name (title), Date (date), Channel (select),
# Approved By (rich text). See README § The published log.
NOTION_TOKEN=
NOTION_MARKETING_DB_ID=

# ── Compliance ───────────────────────────────────────────────────────────────
# Comma-separated. Naming any of these in a draft is a hard block.
COMPETITOR_NAMES=
