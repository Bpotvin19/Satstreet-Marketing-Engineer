/* Satstreet Knowledge Centre — cached research */
function json(data:unknown,status=200){return new Response(JSON.stringify(data),{status,headers:{'content-type':'application/json; charset=utf-8','access-control-allow-origin':'*','cache-control':'no-store'}})}
function terms(q:string){const stop=new Set(['what','which','when','where','why','how','does','from','with','that','this','into','about','have','their','there','would','could','should','the','and','for','are','was','were','you','your','our','its']);return Array.from(new Set((q.toLowerCase().match(/[a-z0-9]{3,}/g)||[]).filter(x=>!stop.has(x))))}
function rank(query:string,chunks:any[],context?:{pageId?:string,ecosystem?:string,level?:string}){const ts=terms(query),out:any[]=[];for(const c of chunks||[]){const low=String(c.text||'').toLowerCase(),title=String(c.pageTitle||'').toLowerCase(),section=String(c.sectionTitle||'').toLowerCase();let score=0;for(const t of ts){score+=(low.split(t).length-1)*2;if(title.includes(t))score+=5;if(section.includes(t))score+=4}if(query.length>5&&low.includes(query.toLowerCase()))score+=14;if(context?.pageId&&c.pageId===context.pageId)score+=8;if(context?.ecosystem&&c.ecosystem===context.ecosystem)score+=5;if(context?.level&&c.level===context.level)score+=3;if(score>0)out.push({...c,score})}out.sort((a,b)=>b.score-a.score);const seen=new Set<string>(),sel:any[]=[];for(const x of out){const k=x.pageId+'|'+x.sectionTitle;if(seen.has(k))continue;seen.add(k);sel.push(x);if(sel.length>=8)break}return sel}
async function synthesize(question:string,passages:any[]){const key=process.env.ANTHROPIC_API_KEY?.trim(),model=process.env.ANTHROPIC_MODEL?.trim();if(!key||!model)return null;const context=passages.map((p,i)=>`[${i+1}] ${p.pageTitle} — ${p.sectionTitle}\n${p.text}`).join('\n\n');const r=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'x-api-key':key,'anthropic-version':'2023-06-01','content-type':'application/json'},body:JSON.stringify({model,max_tokens:700,temperature:.15,system:'You are the Satstreet Knowledge Centre research assistant. Answer only from the supplied Satstreet excerpts. Be concise, educational and precise. Do not give investment, legal, tax or custody advice. Cite claims using [1], [2], etc. If evidence is insufficient, say so.',messages:[{role:'user',content:`Question: ${question}\n\nSatstreet excerpts:\n${context}`}] }),signal:AbortSignal.timeout(15000)});const out=await r.json().catch(()=>({}));if(!r.ok)throw new Error(out?.error?.message||`Research model ${r.status}`);return(out?.content||[]).filter((x:any)=>x.type==='text').map((x:any)=>x.text).join('\n').trim()}
function fallbackAnswer(passages:any[]){if(!passages.length)return'No closely matching Knowledge Centre material was found.';const p=passages[0];return `${p.text.slice(0,700)}${p.text.length>700?'…':''}`}
export default async function handler(request:Request){if(request.method!=='POST')return json({error:'Use POST.'},405);try{const body=await request.json().catch(()=>({})) as any;const question=String(body?.question||'').trim().slice(0,500);if(question.length<3)return json({error:'Ask a complete question.'},400);const origin=new URL(request.url).origin;const r=await fetch(origin+'/data/resources/knowledge-index.json',{headers:{accept:'application/json'},signal:AbortSignal.timeout(6000)});if(!r.ok)throw new Error('Knowledge index unavailable');const idx=await r.json();const passages=rank(question,idx?.chunks||[],{pageId:body?.pageId,ecosystem:body?.ecosystem,level:body?.level});if(!passages.length)return json({answer:null,mode:'retrieval',passages:[],message:'No relevant Knowledge Centre material was found.'});let answer=null;try{answer=await synthesize(question,passages)}catch{}if(!answer)answer=fallbackAnswer(passages);return json({answer,mode:'cached',passages:passages.slice(0,6).map((p,i)=>({...p,excerpt:String(p.text||'').slice(0,260),citation:i+1})),message:null,source:'Satstreet Knowledge Centre cache'})}catch(e){return json({error:e instanceof Error?e.message:'Research request failed.'},500)}}
export const config={path:'/api/resource-research'};
